# Copy this file to backend/.env and fill in the values.
# backend/.env is gitignored. This template is not, so never put real secrets here.

# ─── Database ────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string. Use Atlas rather than a local mongod: a hosted
# container cannot reach localhost, so the deployed app needs a URI that works
# from anywhere.
#
# The database name must appear before the "?" or the app will use the default
# "test" database. If the password contains @ : / ? # or %, percent-encode it.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/pestivid_db?retryWrites=true&w=majority

# Optional tuning. M0 (free) Atlas clusters cap total connections, so keep the
# pool small if you run more than one instance.
MONGO_POOL=10
MONGO_TIMEOUT_MS=10000

# ─── Auth ────────────────────────────────────────────────────────────────────
# Signing key for session tokens. Generate a fresh random one, do not reuse an
# example value:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ─── IPFS storage (Pinata) ───────────────────────────────────────────────────
# SERVER-SIDE ONLY. This must never appear in public/ or any file sent to a
# browser: it grants full pin and unpin rights on the account. Uploads go through
# POST /api/videos/upload so the server can hash the file itself.
PINATA_JWT=

# Largest video accepted, in bytes. Default 100 MB. Streams to a temp file, so
# this bounds disk use per request rather than memory.
MAX_VIDEO_BYTES=104857600
PINATA_TIMEOUT_MS=180000

# ─── AI ──────────────────────────────────────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Flask disease-detection service. Leave blank to run browser-only inference.
FLASK_URL=http://127.0.0.1:5000

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# Bitcoin anchoring via OpenTimestamps (free, no wallet or gas).
ANCHOR_ENABLED=false
ANCHOR_INTERVAL_MS=21600000
ANCHOR_UPGRADE_MS=3600000

# Rate limits (there were none before; /api/videos/upload took a 100 MB body).
RATE_UPLOAD_PER_HOUR=20
RATE_UPLOAD_BURST=5
RATE_AUTH_PER_15MIN=10
RATE_PUBLIC_PER_MIN=60
RATE_GENERAL_PER_MIN=300

# Number of reverse proxies in front of the app (Render/Fly = 1, local = 0).
# Rate limiting keys on the wrong IP if this is wrong.
TRUST_PROXY_HOPS=0
