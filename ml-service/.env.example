# Python AI server (flask_server.py) — copy to .env and fill in.
# Nothing in the code falls back to a shared credential any more; if a value
# is missing the server fails loudly instead of silently degrading.

GROQ_API_KEY=
COHERE_API_KEY=
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=us-east-1

# LLM model id. Kept in config because Groq retires model ids roughly yearly:
#   llama3-70b-8192        decommissioned 2025-08-30
#   llama-3.3-70b-versatile deprecated    2026-06-17
GROQ_MODEL=openai/gpt-oss-120b

# Flask binding. debug=1 enables the Werkzeug debugger, which is a remote
# code-execution surface — never set it on a shared or public host.
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=0

# --- RAG retrieval ---
# embed-multilingual-v3.0 is the same 1024 dims as embed-english-v3.0, so it is a
# drop-in -- but the index MUST be re-embedded when you switch, because vectors
# from the two models are not comparable.
COHERE_EMBED_MODEL=embed-multilingual-v3.0
PINECONE_INDEX=hi

# Retrieval tuning. The score floor is what makes the bot abstain instead of
# answering from the three least-bad chunks when a question is out of corpus.
RAG_TOP_K=5
RAG_SCORE_FLOOR=0.30

# Chat limits
MAX_HISTORY_TURNS=8
MAX_QUESTION_CHARS=4000
GROQ_TIMEOUT_MS=30000
